import random


length = int(input("Введите желаемую длину пароля: "))
lower = "abcdefghijklmnopqrstuvwxyz"
upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
digits = "0123456789"
special = "!@#$%"

symbols = lower + upper + digits + special
"""Создаёт строку со всеми возможными символами.
"""

password = ""
"""Создаёт пустую строку, куда будет записан пароль.
"""


password += random.choice(lower)
password += random.choice(upper)
password += random.choice(digits)
password += random.choice(special)
"""Добавляет в пароль по одному символу каждого типа,
чтобы он был более сложным и уникальным.
"""

for _ in range(length - 4):
    """Создаёт цикл,
    чтобы добавить столько рандомных символов с помощью
    команды random.choice(), сколько не хватает для того чтобы длина
    была равна искомой.
    """
    password += random.choice(symbols)


password = list(password)
"""Преобразует строку password в список,
чтобы использовать random.shuffle() для 
перемешивания символов в пароле.
"""

random.shuffle(password)

password = "".join(password)

print("Ваш пароль:", password)
"""Выводит пароль. """
