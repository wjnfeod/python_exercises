def print_pack_report(count):
    """Создаёт функцию print_pack_report()
    с параметром count - число, с которого нужно посчитать
    по сколько пирожных фасуем в порядке убывания.
    """
    
    for _ in range(1, count + 1):
        """ Создаёт цикл, чтобы повторить действие столько раз, сколько чисел находиться
        в промежутке между 1 и count включительно
        """
        
        if count % 5 == 0 and count % 3 == 0:
            print(count, '- расфасуем по 3 или по 5')
        elif count % 5 == 0 and count % 3 != 0:
            print(count, '- расфасуем по 5')
        elif count % 5 != 0 and count % 3 == 0:
            print(count, '- расфасуем по 3')
        else:
            print(count, '- не заказываем!')

        count -= 1
