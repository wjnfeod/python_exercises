def check_winners(scores, student_score):
    """Создаёт функцию check_winners() с параметрами 
    scores - список всех баллов всех участников, 
    student_score - количество баллов нужного участника.
    """
    
    three_maximums = []
    """Создаёт пустой список three_maximums, 
    куда будут записаны 3 максимальных значений из списка scores.
    """

    for _ in range(3):
        """Добавляет цикл for для _ in range(3), 
        чтобы действия цикла повторились 3 раза.
        """
        
        maximum = max(scores)
        """Ищет максимальное число в списке scores."""
        
        three_maximums.append(maximum)
        """Добавляет его в список с тремя максимумами. """

        scores.remove(maximum)
        """Удаляет максимальное значение из scores, 
        чтобы найти новый максимум.
        """
    
    if student_score in three_maximums:
        """Проверяет есть ли количество баллов нужного участника 
        в числе трёх максимальных значений 
        и выдаёт результат согласно этому.
        """
        print('Вы в тройке победителей!')
    else:
        print('Вы не попали в тройку победителей.')
