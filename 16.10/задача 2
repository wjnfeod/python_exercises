class Book:
    def __init__(self, title, author, year):
        self.title = title
        self.author = author
        self.year = year

    def info(self):
        """Возвращает строку с информацией о книге: навзанием, автором, годом изданияю """

        return f"Название: {self.title}, Автор: {self.author}, Год: {self.year}"
    
class Ebook(Book):
"""Создаёт дочерний класс Ebook От Book"""

    def __init__(self, title, author, year, format):
        super().__init__(title, author, year)
        self.format = format
    def info(self):
    """Переопределяет метод info(). """

        return f"Название: {self.title}, Автор: {self.author}, Год: {self.year}, Формат: {self.format}"
