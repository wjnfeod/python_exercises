from abc import ABC, abstractmethod


class Printable(ABC):
    """Создаёт абстрактный класс для объектов, которые умеют выводить информацию."""

    @abstractmethod
    def print_info(self, title, author, year):
        """Создаёт абстрактный метод для вывода информации."""

        pass


class Book(Printable):
    """Создаёт класс Book, реализующий интерфейс Printable."""

    def print_info(self, title, author, year):
        """Возвращает строку с названием книги, автором и годом издания."""

        return f"Название книги: {title}, автор: {author}, год издания: {year}"
