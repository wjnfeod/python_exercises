from datetime import datetime


class Book:
    def __init__(self, title, author, year):
        self.title = title
        self.author = author
        self.year = year

    def info(self):
        """Возвращает строку с информацией о книге: названием, автором и годом издания."""
        return f"Название книги: {self.title}, автор: {self.author}, год издания: {self.year}"


    def __str__(self):
        """Возвращает текстовое представление объекта Book."""
        return self.info()


    def __eq__(self, other):
        """Сравнивает две книги по названию. Возвращает True, если названия совпадают."""
        return isinstance(other, Book) and self.title == other.title


    @property
    def age(self):
        """Возвращает возраст книги в годах, вычисленный по году издания."""
        return datetime.now().year - self.year


    @age.setter
    def age(self, value):
        """Устанавливает возраст книги и пересчитывает год её издания."""
        self.year = datetime.now().year - value


    @classmethod
    def from_string(cls, data):
        """Создаёт объект Book из строки с названием, автором и годом издания."""
        title, author, year = data.split(';')
        return cls(title, author, int(year))
